#include <Geode/Geode.hpp>
#include <Geode/modify/LevelEditorLayer.hpp>

using namespace geode::prelude;

static constexpr int kCheckpointObjectID = 1011;
static constexpr int kCheckpointLabelTag = 58291;

// its something. i will fix it later. maybe.

static void updateCheckpointLabels(LevelEditorLayer *layer)
{
    if (!layer || !layer->m_objects)
        return;

    std::vector<GameObject *> checkpoints;
    checkpoints.reserve(layer->m_objects->count());

    for (int i = 0; i < layer->m_objects->count(); ++i)
    {
        if (auto obj = typeinfo_cast<GameObject *>(layer->m_objects->objectAtIndex(i)))
        {
            if (obj->m_objectID == kCheckpointObjectID)
            {
                checkpoints.push_back(obj);
            }
        }
    }

    std::sort(checkpoints.begin(), checkpoints.end(), [](GameObject *a, GameObject *b)
              {
        if (a->getPositionX() == b->getPositionX()) {
            return a->getPositionY() < b->getPositionY();
        }
        return a->getPositionX() < b->getPositionX(); });

    for (size_t i = 0; i < checkpoints.size(); ++i)
    {
        auto checkpoint = checkpoints[i];
        checkpoint->removeChildByTag(kCheckpointLabelTag);

        auto label = CCLabelBMFont::create(fmt::format("{}", i + 1).c_str(), "bigFont.fnt");
        label->setScale(0.45f);
        label->setAnchorPoint({0.5f, 0.0f});
        label->setPosition({0.0f, 18.0f});
        label->setColor({255, 220, 50});
        label->setTag(kCheckpointLabelTag);

        checkpoint->addChild(label, 10);
    }
}

class $modify(LevelEditorLayer)
{
    bool init(GJGameLevel *level, bool unk)
    {
        if (!LevelEditorLayer::init(level, unk))
            return false;

        updateCheckpointLabels(this);
        return true;
    }

    GameObject *addObject(int id, cocos2d::CCPoint pos)
    {
        auto obj = LevelEditorLayer::addObject(id, pos);
        if (obj && obj->m_objectID == kCheckpointObjectID)
        {
            updateCheckpointLabels(this);
        }
        return obj;
    }

    void removeObject(GameObject *obj, bool updateGroups)
    {
        auto wasCheckpoint = obj && obj->m_objectID == kCheckpointObjectID;
        LevelEditorLayer::removeObject(obj, updateGroups);
        if (wasCheckpoint)
        {
            updateCheckpointLabels(this);
        }
    }

    void createObjectsFromString(gd::string str, bool unk1, bool unk2)
    {
        LevelEditorLayer::createObjectsFromString(str, unk1, unk2);
        updateCheckpointLabels(this);
    }

    void pasteObjects(gd::string str, bool unk)
    {
        LevelEditorLayer::pasteObjects(str, unk);
        updateCheckpointLabels(this);
    }

    void undoLastAction(CCObject *sender)
    {
        LevelEditorLayer::undoLastAction(sender);
        updateCheckpointLabels(this);
    }

    void redoLastAction(CCObject *sender)
    {
        LevelEditorLayer::redoLastAction(sender);
        updateCheckpointLabels(this);
    }
};